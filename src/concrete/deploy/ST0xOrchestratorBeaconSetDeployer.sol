pragma solidity =0.8.25;

import {IBeacon} from "@openzeppelin-contracts-5.6.1/proxy/beacon/IBeacon.sol";
import {UpgradeableBeacon} from "@openzeppelin-contracts-5.6.1/proxy/beacon/UpgradeableBeacon.sol";
import {BeaconProxy} from "@openzeppelin-contracts-5.6.1/proxy/beacon/BeaconProxy.sol";
import {ERC165} from "@openzeppelin-contracts-5.6.1/utils/introspection/ERC165.sol";

import {LibTimelockInvariants} from "../../lib/LibTimelockInvariants.sol";

import {ST0xOrchestrator} from "../ST0xOrchestrator.sol";
import {LibProdDeployCurrent} from "../../generated/LibProdDeployCurrent.sol";
import {IST0xOrchestratorBeaconSetDeployerV1} from "../../interface/IST0xOrchestratorBeaconSetDeployerV1.sol";

/// @title ST0xOrchestratorBeaconSetDeployer
/// @notice Deploys `ST0xOrchestrator` instances as `BeaconProxy` instances
/// pointing at a shared beacon. The orchestrator is a singleton, one instance
/// serving every token, so a deployment is not bound to any vault.
///
/// The beacon's implementation is hardcoded from `LibProdDeployCurrent` and
/// its owner is the governance timelock of the chain the constructor runs on
/// (`LibTimelockInvariants.timelockForChainId`), so the constructor takes no
/// input and this contract is Zoltu-deployable directly; its deterministic
/// address is generated by `script/Build.sol`. The constructor reverts on a
/// chain with no pinned timelock.
contract ST0xOrchestratorBeaconSetDeployer is ERC165, IST0xOrchestratorBeaconSetDeployerV1 {
    /// The beacon every deployed orchestrator proxy points at.
    IBeacon public immutable iOrchestratorBeacon;

    constructor() {
        iOrchestratorBeacon = new UpgradeableBeacon(
            LibProdDeployCurrent.ST0X_ORCHESTRATOR, LibTimelockInvariants.timelockForChainId(block.chainid)
        );
    }

    /// @notice Deploy an `ST0xOrchestrator` singleton. Callable by anyone,
    /// and the caller does not choose the owner: `initialize` seats the
    /// chain's governance timelock inside this same transaction, so nothing
    /// here can point the instance elsewhere. The timelock is emitted as
    /// `owner` so the value the proxy took is on the log rather than only in
    /// storage.
    function deploy() external returns (address) {
        bytes memory initData = abi.encodeCall(ST0xOrchestrator.initialize, ());
        BeaconProxy proxy = new BeaconProxy(address(iOrchestratorBeacon), initData);

        address owner = LibTimelockInvariants.timelockForChainId(block.chainid);
        emit Deployment(msg.sender, address(proxy), owner);
        return address(proxy);
    }

    /// @inheritdoc ERC165
    function supportsInterface(bytes4 interfaceId) public view override returns (bool) {
        return
            interfaceId == type(IST0xOrchestratorBeaconSetDeployerV1).interfaceId
                || super.supportsInterface(interfaceId);
    }
}
